{
  "name": "rhythm-royale",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "build-server": "rm -rf dist/server dist/shared && tsc -p tsconfig.server.json",
    "dev": "ts-node -P tsconfig.server.json src/server/server.ts",
    "start:all": "concurrently --kill-others --names server,client --prefix-colors blue,magenta \"npm:dev\" \"npm:start\"",
    "stop:all": "kill $(lsof -t -i tcp:3000 -i tcp:4200 -sTCP:LISTEN) 2>/dev/null && echo 'Stopped dev servers' || echo 'No dev servers running on ports 3000/4200'",
    "build:all": "ng build && npm run build-server",
    "start:prod": "node dist/server/server.js",
    "test:server": "vitest run --config vitest.server.config.mts",
    "test:e2e": "playwright test"
  },
  "private": true,
  "dependencies": {
    "@angular/cdk": "^22.2.7",
    "@angular/common": "^22.2.6",
    "@angular/compiler": "^22.2.6",
    "@angular/core": "^22.2.6",
    "@angular/forms": "^22.2.6",
    "@angular/material": "^22.2.7",
    "@angular/platform-browser": "^22.2.6",
    "@angular/router": "^22.2.6",
    "bootstrap": "^5.3.3",
    "dotenv": "^16.4.7",
    "express": "^4.19.2",
    "helmet": "^8.3.0",
    "rxjs": "~7.8.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "ts-node": "^10.9.2",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.7",
    "@angular/cli": "^22.2.7",
    "@angular/compiler-cli": "^22.2.6",
    "@playwright/test": "^1.65.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "concurrently": "^10.0.7",
    "jsdom": "^27.0.0",
    "nodemon": "^3.1.4",
    "typescript": "~6.0.3",
    "vitest": "^5.0.0"
  }
}
